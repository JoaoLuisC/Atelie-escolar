{
  "name": "atelie-da-escola",
  "version": "1.0.0",
  "description": "Plataforma de vendas de materiais educativos - Ateliê da Escola",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:api": "node server.js",
    "dev:all": "concurrently -k -n WEB,API -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "start": "node server.js",
    "build": "vite build",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:web": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=19",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,api,lib,routes,middleware,services,utils,validation,scripts}/**/*.{js,jsx,css}\" \"*.config.js\" server.js",
    "format:check": "prettier --check \"{src,api,lib,routes,middleware,services,utils,validation,scripts}/**/*.{js,jsx,css}\" \"*.config.js\" server.js",
    "check:env": "node scripts/check-env.js",
    "check": "npm run check:env && npm run format:check && npm run lint && npm run test && npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build",
    "supabase:login": "npx supabase login",
    "supabase:init": "npx supabase init",
    "supabase:link": "npx supabase link",
    "supabase:db:pull": "npx supabase db pull",
    "supabase:db:push": "npx supabase db push",
    "supabase:migration:new": "npx supabase migration new",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "banners",
    "e-commerce",
    "mercado-pago"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "@vercel/analytics": "^1.4.0",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "mercadopago": "^2.0.0",
    "nodemailer": "^9.0.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.73.1",
    "react-router-dom": "^7.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.10",
    "prettier": "^3.4.2",
    "supabase": "^2.88.1",
    "tailwindcss": "^3.4.17",
    "vercel": "^33.0.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
