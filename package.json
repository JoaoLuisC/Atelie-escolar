{
  "name": "atelie-da-escola",
  "version": "1.0.0",
  "description": "Plataforma de vendas de materiais educativos - Ateliê da Escola",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server.js",
    "dev:server": "node server.js",
    "dev:all": "concurrently -k -n WEB,API -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:full": "npm run dev:all",
    "start": "node server.js",
    "dev:web": "vite",
    "bootstrap": "npm install",
    "setup:dev": "npm run check",
    "build": "npm run build:web",
    "build:web": "vite build",
    "test": "npm run test:web",
    "test:web": "vitest run",
    "check": "npm run test:web && npm run build:web",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "rebuild": "npm run clean && npm run build:web",
    "preview:web": "vite preview",
    "supabase:login": "npx supabase login",
    "supabase:init": "npx supabase init",
    "supabase:link": "npx supabase link",
    "supabase:db:pull": "npx supabase db pull",
    "supabase:db:push": "npx supabase db push",
    "supabase:migration:new": "npx supabase migration new",
    "supabase:types": "npx supabase gen types typescript --linked --schema public > src/types/supabase.ts"
  },
  "keywords": [
    "banners",
    "e-commerce",
    "mercado-pago"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "mercadopago": "^2.0.0",
    "nodemailer": "^8.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.73.1",
    "react-router-dom": "^7.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.10",
    "supabase": "^2.88.1",
    "tailwindcss": "^3.4.17",
    "vercel": "^33.0.0",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
