# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=product-files

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN=TEST-123456789-123456-abcdef1234567890
MERCADOPAGO_PUBLIC_KEY=TEST-abcdef12-3456-7890-abcd-ef1234567890

# App Configuration
APP_URL=http://localhost:3000
APP_ENV=development

# Security — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=seu_webhook_secret_aqui
DOWNLOAD_TOKEN_SECRET=seu_token_secret_para_downloads
ADMIN_SESSION_SECRET=seu_admin_session_secret_aqui
CUSTOMER_SESSION_SECRET=seu_customer_session_secret_aqui

# Admin access is now managed in Supabase Auth + profiles.role
# Create the admin/master user directly in Supabase and assign the role there.

# E-mail transacional — Resend (https://resend.com)
# 1. Conta em resend.com → onboarding gera API key (re_...)
# 2. Para produção: configurar SPF + DKIM + DMARC no DNS do seu domínio
#    em https://resend.com/domains, senão Resend só entrega para o e-mail da conta.
# 3. SMTP_FROM precisa usar um domínio verificado (no sandbox use onboarding@resend.dev).
# NÃO usar Gmail: limite de 500/dia, From: forçadamente do próprio Gmail, sem DKIM próprio.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=Ateliê da Escola <onboarding@resend.dev>

# Analytics (Fase 0)
# Deixe em branco para não carregar os trackers. Quando preencher,
# o ConsentBanner do site continua valendo: scripts só sobem após
# o usuário aceitar cookies de marketing.
VITE_GA4_ID=
VITE_META_PIXEL_ID=

# Coletor opcional de eventos de segurança (Slack incoming webhook,
# Discord webhook, Sentry webhook, etc.). Recebe POST JSON contendo
# { event, severity, ip, user_agent, properties, timestamp } toda vez
# que dispara um evento como webhook_invalid_signature ou
# admin_login_failed. Em branco → só vai pro stdout e pra tabela
# public.security_events. Ver lib/security-logger.js.
SECURITY_ALERT_WEBHOOK_URL=

# Cron de e-mail (GitHub Actions → POST /api/cron-email-jobs). O mesmo valor
# precisa estar na Vercel (env) E no GitHub (Settings → Secrets → Actions).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=seu_cron_secret_aqui

# Janela do lembrete de carrinho abandonado, em horas (api/cron-email-jobs.js).
ABANDONED_CART_FIRST_HOURS=1
ABANDONED_CART_SECOND_HOURS=24

# Janela de reativação (dias de inatividade) para o e-mail "sentimos sua falta".
REACTIVATION_DAYS_MIN=90
REACTIVATION_DAYS_MAX=180

# Limiar de LTV (R$) para marcar o cliente como VIP na segmentação.
# Ver lib/customer-segmentation.js (default 300).
VIP_LTV_THRESHOLD=300

# CORS: lista separada por vírgula das origens permitidas em produção.
# Em branco → libera qualquer localhost/127.0.0.1 (só dev). Ver server.js.
# Ex prod: https://atelie.com.br,https://www.atelie.com.br
CORS_ORIGINS=

# Rate limit global de requisições por janela (express-rate-limit).
# Ver server.js (default 250). O limite de auth é AUTH_RATE_LIMIT_MAX (default 30).
RATE_LIMIT_MAX=250
