# Firebase Configuration
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN=TEST-123456789-123456-abcdef1234567890
MERCADOPAGO_PUBLIC_KEY=TEST-abcdef12-3456-7890-abcd-ef1234567890

# App Configuration
APP_URL=http://localhost:3000
NODE_ENV=development

# Security
WEBHOOK_SECRET=seu_webhook_secret_aqui
DOWNLOAD_TOKEN_SECRET=seu_token_secret_para_downloads

# E-mail (SMTP) — configure para enviar e-mails de confirmação
# Gmail: habilite "Senha de app" em https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=Ateliê da Escola <no-reply@ateliedaescola.com>
