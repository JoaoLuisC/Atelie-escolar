# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=product-files

# Mercado Pago Configuration
MERCADOPAGO_ACCESS_TOKEN=TEST-123456789-123456-abcdef1234567890
MERCADOPAGO_PUBLIC_KEY=TEST-abcdef12-3456-7890-abcd-ef1234567890

# App Configuration
APP_URL=http://localhost:3000
APP_ENV=development

# Security — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=seu_webhook_secret_aqui
# LEGADO E INERTE — nao gere valor novo esperando protecao.
# Nenhum arquivo de handlers/ ou lib/ le esta variavel: os tokens de download
# sao valores opacos gerados e conferidos em `download_tokens`, sem HMAC. Ela
# ficou fora de REQUIRED_PRODUCTION_SECRETS (server.js) e de scripts/check-env.js
# justamente para nao sugerir que um segredo rotacionado endurece a entrega.
# Continua listada aqui so para que quem encontrar o nome no .env antigo saiba
# que pode apagar.
DOWNLOAD_TOKEN_SECRET=
ADMIN_SESSION_SECRET=seu_admin_session_secret_aqui
CUSTOMER_SESSION_SECRET=seu_customer_session_secret_aqui
# Cifra o totpSecret do 2FA em repouso (lib/admin-2fa.js). ATENCAO: trocar esta
# chave torna o segredo TOTP ja gravado ilegivel e o 2FA para de abrir — para
# rotacionar, recadastre o segundo fator no painel depois da troca.
ADMIN_2FA_ENC_KEY=sua_chave_de_cifra_do_2fa_aqui

# Admin access is now managed in Supabase Auth + profiles.role
# Create the admin/master user directly in Supabase and assign the role there.

# E-mail transacional — Resend (https://resend.com)
# 1. Conta em resend.com → onboarding gera API key (re_...)
# 2. Para produção: configurar SPF + DKIM + DMARC no DNS do seu domínio
#    em https://resend.com/domains, senão Resend só entrega para o e-mail da conta.
# 3. SMTP_FROM precisa usar um domínio verificado (no sandbox use onboarding@resend.dev).
# NÃO usar Gmail: limite de 500/dia, From: forçadamente do próprio Gmail, sem DKIM próprio.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=Ateliê da Escola <onboarding@resend.dev>

# Supabase no FRONTEND (bundle do Vite). Sao as mesmas credenciais publicas
# do bloco do topo, com o prefixo VITE_ — o `envPrefix` do vite.config.js so
# expoe variavel comecada por VITE_, entao sem estas duas o front sobe sem
# cliente Supabase: login com Google e reset de senha param. Estavam apenas
# no .env.local.template, e quem seguia ESTE arquivo montava um front quebrado.
# NUNCA colocar a service role key aqui: tudo com VITE_ vai para o bundle.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Bypass do painel admin em DESENVOLVIMENTO. O codigo exige
# `import.meta.env.DEV` junto (src/components/ProtectedRoute.jsx), entao o flag
# e inerte num build de producao mesmo que vaze para o deploy — e as APIs
# continuam exigindo sessao de qualquer jeito.
VITE_ALLOW_ADMIN_BYPASS=

# Analytics (Fase 0)
# Deixe em branco para não carregar os trackers. Quando preencher,
# o ConsentBanner do site continua valendo: scripts só sobem após
# o usuário aceitar cookies de marketing.
VITE_GA4_ID=
VITE_META_PIXEL_ID=

# Coletor opcional de eventos de segurança (Slack incoming webhook,
# Discord webhook, Sentry webhook, etc.). Recebe POST JSON contendo
# { event, severity, ip, user_agent, properties, timestamp } toda vez
# que dispara um evento como webhook_invalid_signature ou
# admin_login_failed. Em branco → só vai pro stdout e pra tabela
# public.security_events. Ver lib/security-logger.js.
SECURITY_ALERT_WEBHOOK_URL=

# Cron de e-mail (GitHub Actions → POST /api/cron-email-jobs). O mesmo valor
# precisa estar na Vercel (env) E no GitHub (Settings → Secrets → Actions).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=seu_cron_secret_aqui

# Janela do lembrete de carrinho abandonado, em horas (api/cron-email-jobs.js).
ABANDONED_CART_FIRST_HOURS=1
ABANDONED_CART_SECOND_HOURS=24

# Janela de reativação (dias de inatividade) para o e-mail "sentimos sua falta".
REACTIVATION_DAYS_MIN=90
REACTIVATION_DAYS_MAX=180

# Limiar de LTV (R$) para marcar o cliente como VIP na segmentação.
# Ver lib/customer-segmentation.js (default 300).
VIP_LTV_THRESHOLD=300

# CORS: lista separada por vírgula das origens permitidas em produção.
# Em branco → libera qualquer localhost/127.0.0.1 (só dev). Ver server.js.
# Ex prod: https://atelie.com.br,https://www.atelie.com.br
CORS_ORIGINS=

# Rate limit global de requisições por janela (express-rate-limit).
# Ver server.js (default 250). É o ÚNICO limitador do Express — a política
# real é enforceRateLimit no handler (regra E1 / ADR 0007), e ela não usa
# variável de ambiente: os perfis estão em lib/rate-limit.js.
RATE_LIMIT_MAX=250

# ── Ajustes finos (todos tem default no codigo; deixe em branco para usar) ──
# Cada linha aqui existe porque a variavel E lida em runtime. Variavel lida e
# nao listada e a que ninguem descobre ate precisar mudar o comportamento em
# producao — por isso scripts/__tests__/deploy-config.test.js compara as duas
# listas e falha apontando o nome.

# Nivel minimo do log estruturado (lib/logger.js): debug | info | warn | error.
LOG_LEVEL=

# Timeout e intervalo de alerta do rate limit (lib/rate-limit.js). O timeout
# e o que decide quanto o gate espera o Postgres antes de aplicar o failMode.
RATE_LIMIT_TIMEOUT_MS=
RATE_LIMIT_ALERT_INTERVAL_MS=

# Timeout das chamadas ao PostgREST/Storage (lib/supabase.js).
SUPABASE_REQUEST_TIMEOUT_MS=

# Janela e teto de varredura do "mais vendidos" (lib/sales-counts.js).
BEST_SELLERS_WINDOW_MONTHS=
BEST_SELLERS_SCAN_LIMIT=

# Envio de e-mail: conexoes do pool SMTP (lib/email-sender.js) e envios
# simultaneos por laco do cron (handlers/cron-email-jobs.js). Subir os dois
# sem confirmar o limite do provedor troca "lento" por "bloqueado".
SMTP_MAX_CONNECTIONS=
EMAIL_SEND_CONCURRENCY=

# Cupom oferecido no e-mail de reativacao (handlers/cron-email-jobs.js).
# Muda o que a cliente recebe: o codigo precisa existir em `coupons`.
REACTIVATION_COUPON_CODE=
REACTIVATION_COUPON_PCT=

# Para onde o Supabase manda quem acabou de ganhar conta no checkout
# (lib/customer-account-provisioning.js).
CUSTOMER_PASSWORD_SETUP_REDIRECT=

# ── So para ferramenta local, nunca para o runtime da aplicacao ──
# `CHECK_ENV_STRICT=1` faz `npm run check:env` FALHAR no lugar de avisar.
CHECK_ENV_STRICT=
# Personal access token e ref do projeto para scripts/check-advisor.js.
SUPABASE_PAT=
SUPABASE_PROJECT_REF=
