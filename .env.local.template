# ════════════════════════════════════════════════════════════════════
# Template de desenvolvimento local.
#
# O ARQUIVO CANÔNICO É `.env.example` — ele lista TODAS as variáveis, cada uma
# com o comentário do que quebra sem ela. Este aqui é o subconjunto mínimo para
# `npm run dev:all` subir, e existia divergente do `.env.example` (sem os dois
# segredos de sessão, sem SMTP, sem CORS_ORIGINS), o que fazia quem o seguisse
# bater em falhas que o outro arquivo já explicava.
#
# Ao acrescentar variável nova, acrescente no `.env.example` primeiro.
# ════════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=product-files

# Espelho para o bundle do front (Vite inlina — são públicas por design).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Mercado Pago ────────────────────────────────────────────────────
# Obtenha em: https://www.mercadopago.com.br/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# ── App ─────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
APP_ENV=development

# Origens aceitas pelo CORS. Vazio em development/test cai no default que
# libera qualquer porta de localhost; FORA de dev/test é obrigatório e o boot
# falha sem ele (lib/express-app.js).
CORS_ORIGINS=

# ── Segredos ────────────────────────────────────────────────────────
# Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Em development/test há fallback embutido, então dá para subir sem eles; fora
# de dev/test a ausência derruba o boot (lib/env-secret.js, fail-closed).
WEBHOOK_SECRET=
DOWNLOAD_TOKEN_SECRET=
ADMIN_SESSION_SECRET=
CUSTOMER_SESSION_SECRET=
CRON_SECRET=

# Cifra o totpSecret do 2FA em repouso (lib/admin-2fa.js). ATENÇÃO: trocar esta
# chave torna o segredo TOTP já gravado ilegível e o 2FA para de abrir — para
# rotacionar, recadastre o segundo fator no painel depois da troca.
ADMIN_2FA_ENC_KEY=

# ── SMTP (Resend) ───────────────────────────────────────────────────
# Sem eles o envio degrada em silêncio: o pedido é aprovado e o cliente nunca
# recebe o e-mail com o link de download.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Acesso admin ────────────────────────────────────────────────────
# A conta admin/master é criada direto no Supabase Auth, com profiles.role
# ajustado pela service role. Não há credencial de admin em variável.
