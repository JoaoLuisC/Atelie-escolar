rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Arquivos de produtos - Sem acesso direto
    match /products/{productId}/{fileName} {
      allow read: if false; // Apenas via signed URLs geradas pelo backend
      allow write: if false; // Apenas via Admin SDK
    }
    
    // Imagens públicas dos produtos
    match /images/{imageId} {
      allow read: if true;
      allow write: if false; // Apenas via Admin SDK
    }
  }
}
