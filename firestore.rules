rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Produtos - Leitura pública, escrita apenas para usuários autenticados
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null; // Permite escrita para usuários autenticados
    }

    // Categorias - Leitura pública, escrita apenas para usuários autenticados
    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Pedidos - usuário autenticado lê os próprios pedidos; admin lê todos; criação pública
    match /orders/{orderId} {
      allow read:   if request.auth != null && (
                        request.auth.token.email == 'admin@ateliedaescola.com' ||
                        resource.data.customer.email == request.auth.token.email
                    );
      allow create: if true;
      allow update: if request.auth != null
                    && request.auth.token.email == 'admin@ateliedaescola.com';
      allow delete: if false;
    }
    
    // Clientes - Histórico de compras por email
    match /customers/{email} {
      allow read, write: if false; // Apenas via Admin SDK
    }

    // Produtos comprados por usuário — usuário lê o próprio documento
    match /userProducts/{email} {
      allow read: if request.auth != null && request.auth.token.email == email;
      allow write: if false; // Apenas via Admin SDK
    }
    
    // Tokens de download - Sem acesso direto
    match /downloadTokens/{tokenId} {
      allow read, write: if false; // Apenas via Admin SDK
    }
    
    // Logs de download - Admin lê para métricas de dashboard
    match /downloadLogs/{logId} {
      allow read:  if request.auth != null
                   && request.auth.token.email == 'admin@ateliedaescola.com';
      allow write: if false; // Apenas via Admin SDK
    }

    // Usuários - cada usuário lê/escreve o próprio perfil; autenticados leem todos
    match /users/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Configurações admin — adminConfig: só admin lê/escreve; homeSections: leitura pública
    match /settings/adminConfig {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'admin@ateliedaescola.com';
    }
    match /settings/homeSections {
      allow read:  if true;  // leitura pública (usada na página inicial)
      allow write: if request.auth != null
                   && request.auth.token.email == 'admin@ateliedaescola.com';
    }
    match /settings/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'admin@ateliedaescola.com';
    }

    // Visualizações de página — admin lê para métricas; escrita apenas via Admin SDK
    match /pageViews/{docId} {
      allow read:  if request.auth != null
                   && request.auth.token.email == 'admin@ateliedaescola.com';
      allow write: if false; // Admin SDK bypasses rules
    }
  }
}